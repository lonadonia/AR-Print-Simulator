# Copy to `.env.production.local` (never commit real values) or set these in your host's
# build settings. All VITE_* values are compiled into the browser bundle and are PUBLIC.
# Never put CMS credentials, API keys or admin tokens here.

# Where the catalog (rooms, artwork, materials, categories) comes from:
#   wix  - production: catalog is sent by the Wix page code through postMessage (default)
#   demo - development / contest preview: bundled sample content, clearly labelled as demo
VITE_CATALOG_SOURCE=wix

# Exact origins of the Wix pages allowed to embed and talk to the editor (comma separated).
# Include the published domain(s) and, if you test in Wix preview, the preview origin.
# A leading "*." wildcard is accepted for incoming messages only, e.g. https://*.wixsite.com
VITE_ALLOWED_PARENT_ORIGINS=https://www.example.com,https://example.wixsite.com

# Hosts from which catalog images may be loaded (comma separated, HTTPS only).
VITE_ALLOWED_IMAGE_HOSTS=static.wixstatic.com

# Optional product title shown in the editor header.
VITE_APP_TITLE=Room Visualizer
