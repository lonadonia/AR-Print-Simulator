# Public, non-secret settings for the local integration harness (`npm run build:harness`).
# The editor talks to the simulated Wix page on another local origin.
VITE_CATALOG_SOURCE=wix
VITE_ALLOWED_PARENT_ORIGINS=http://localhost:4174
VITE_ALLOWED_IMAGE_HOSTS=localhost
VITE_APP_TITLE=Room Visualizer (harness)
